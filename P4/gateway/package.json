{
  "name": "p4-gateway",
  "version": "1.0.0",
  "description": "API Gateway (reverse proxy hacia los 4 microservicios) - Practica 4 Software Avanzado USAC",
  "main": "dist/server.js",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}

# Puertos expuestos al host (distintos de los usados por P1/P2, para poder correr
# varias practicas a la vez)
GATEWAY_PORT=4000
IDENTIDAD_SERVICE_PORT=4100
TICKETS_SERVICE_PORT=4200
ASIGNACION_SERVICE_PORT=8000
NOTIFICACIONES_SERVICE_PORT=4400

# PostgreSQL: un contenedor por microservicio (database-per-service), mismas
# credenciales por simplicidad, cada uno con su propia base de datos y volumen
DB_USER=p4_user
DB_PASSWORD=change_me
DB_IDENTIDAD_NAME=p4_identidad_db
DB_IDENTIDAD_PORT=5433
DB_TICKETS_NAME=p4_tickets_db
DB_TICKETS_PORT=5434
DB_ASIGNACION_NAME=p4_asignacion_db
DB_ASIGNACION_PORT=5435
DB_NOTIFICACIONES_NAME=p4_notificaciones_db
DB_NOTIFICACIONES_PORT=5436

# JWT: solo identidad-service conoce este secreto (firma y verifica). Los demas
# servicios nunca verifican la firma directamente, consultan a identidad-service
# via POST /authorize (mismo patron que el auth-service de P2).
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=30m

# Cliente HTTP con reintentos/backoff usado por tickets-service y
# notificaciones-service al consultar /authorize en identidad-service
AUTHZ_SERVICE_URL=http://identidad-service:4100
AUTHZ_MAX_RETRIES=3
AUTHZ_RETRY_BACKOFF_MS=300

# Secreto compartido para llamadas servicio-a-servicio que no pasan por el Gateway
# ni requieren el token del usuario final (tickets-service -> asignacion-service /
# notificaciones-service). Ver justificacion en README.md
INTERNAL_SERVICE_SECRET=change_me_internal_secret

# URLs internas (red de Docker Compose) que tickets-service usa para llamar
# directamente a los otros dos microservicios al crear/actualizar un ticket
ASIGNACION_SERVICE_URL=http://asignacion-service:8000
NOTIFICACIONES_SERVICE_URL=http://notificaciones-service:4400

# Cuenta Admin y cuentas Agente creadas automaticamente en identidad-service al
# arrancar (si no existen todavia), solo para desarrollo/pruebas locales
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin12345
AGENTE1_NOMBRE=Agente Soporte Software
AGENTE1_EMAIL=agente.software@mesadeayuda.com
AGENTE1_PASSWORD=Agente12345
AGENTE2_NOMBRE=Agente Soporte Hardware
AGENTE2_EMAIL=agente.hardware@mesadeayuda.com
AGENTE2_PASSWORD=Agente12345

    {
      "name": "01 - Identidad",
      "description": "Registro, login y autorizacion por roles. Correr en orden: cada login guarda su token en una variable de coleccion, usada por las demas carpetas.",
      "item": [
        {
          "name": "Registrar Cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "// Correo unico por corrida, para poder re-ejecutar la coleccion sin chocar con 409",
                  "pm.collectionVariables.set(\"cliente_correo\", \"cliente.\" + Date.now() + \"@mesadeayuda.com\");",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.test(\"201 Created\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"rol es CLIENTE\", function () { pm.expect(data.rol).to.eql(\"CLIENTE\"); });",
                  "pm.collectionVariables.set(\"cliente_id\", data.id);",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/identidad/registro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "identidad",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"correo\": \"{{cliente_correo}}\",\n  \"contrasena\": \"Cliente1234\"\n}",

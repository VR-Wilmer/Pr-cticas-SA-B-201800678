    {
      "name": "02 - Tickets (GraphQL)",
      "description": "Requiere haber corrido la carpeta 01 - Identidad antes (usa cliente_token/agente_hw_token). El codigo HTTP de la respuesta refleja el error real (401/403/etc, via extensions.http.status de Apollo Server), y el detalle siempre queda ademas en el campo 'errors' de la respuesta JSON.",
      "item": [
        {
          "name": "Crear Ticket - Hardware (con agente disponible)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.test(\"200 OK sin errores\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().errors).to.be.undefined;",
                  "});",
                  "const ticket = pm.response.json().data.crearTicket;",
                  "pm.test(\"queda ASIGNADO a un agente\", function () {",
                  "  pm.expect(ticket.estado).to.eql(\"ASIGNADO\");",
                  "  pm.expect(ticket.agenteId).to.not.be.null;",
                  "});",
                  "pm.collectionVariables.set(\"ticket_id_hw\", ticket.id);",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{cliente_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CrearTicket($titulo: String!, $descripcion: String!, $categoria: CategoriaTicket!) {\n  crearTicket(titulo: $titulo, descripcion: $descripcion, categoria: $categoria) {\n    id\n    titulo\n    estado\n    categoria\n    clienteCorreo\n    agenteId\n    agenteNombre\n  }\n}",
                "variables": "{\n  \"titulo\": \"No enciende la PC\",\n  \"descripcion\": \"Se apaga sola al iniciar Windows\",\n  \"categoria\": \"HARDWARE\"\n}"
              }
            }
          },
          "response": []
        },

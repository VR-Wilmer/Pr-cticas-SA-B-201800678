      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tasa de error 5xx por servicio",
      "description": "¿Qué servicio está devolviendo errores del servidor? Es el primer paso del runbook: de la alerta al servicio culpable.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "(sum by (service) (rate(sa_http_server_duration_seconds_count{namespace=\"$namespace\", service=~\"$servicio\", status_code=~\"5..\"}[5m])) or sum by (service) (rate(sa_http_server_duration_seconds_count{namespace=\"$namespace\", service=~\"$servicio\"}[5m])) * 0) / sum by (service) (rate(sa_http_server_duration_seconds_count{namespace=\"$namespace\", service=~\"$servicio\"}[5m]))",
          "legendFormat": "{{service}}",
          "datasource": {

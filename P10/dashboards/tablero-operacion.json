{
  "uid": "sa-platform-operacion",
  "title": "sa-platform — Operación",
  "description": "Tablero de operación de la Práctica 10: SLO, las cuatro señales de oro, canary y registros de error.",
  "tags": [
    "sa-platform",
    "p10",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Ambiente",
        "type": "custom",
        "query": "sa-p8-staging,sa-p8-prod",
        "current": {
          "text": "sa-p8-staging",
          "value": "sa-p8-staging"
        },
        "options": [
          {
            "text": "sa-p8-staging",
            "value": "sa-p8-staging",
            "selected": true
          },
          {
            "text": "sa-p8-prod",
            "value": "sa-p8-prod",
            "selected": false
          }
        ]
      },
      {
        "name": "servicio",
        "label": "Servicio",
        "type": "custom",
        "includeAll": true,
        "multi": true,
        "allValue": "gateway|identidad-service|tickets-service|asignacion-service|notificaciones-service",
        "query": "gateway,identidad-service,tickets-service,asignacion-service,notificaciones-service",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Alertas de SLO",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", slo!=\"\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{namespace}}"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Qué vive el usuario (SLO y negocio)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Disponibilidad (5 min)",
      "description": "¿Qué proporción de las peticiones de los clientes se está respondiendo sin error ahora mismo? Objetivo 99.5 %.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sli:disponibilidad:ratio_rate5m{namespace=\"$namespace\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Presupuesto de error restante — disponibilidad",
      "description": "¿Cuánto margen de errores queda en la ventana de 30 días antes de incumplir el SLO? (100 % = intacto, 0 % = agotado)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "slo:presupuesto_error:restante_ratio{slo=\"disponibilidad\", namespace=\"$namespace\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Peticiones bajo 1 s (5 min)",
      "description": "¿Qué proporción de las peticiones se responde en menos de 1 segundo? Objetivo 99 %.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "sli:latencia:ratio_rate5m{namespace=\"$namespace\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.98
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Presupuesto de error restante — latencia",
      "description": "¿Cuánto margen de peticiones lentas queda en la ventana de 30 días?",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "slo:presupuesto_error:restante_ratio{slo=\"latencia\", namespace=\"$namespace\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Tickets creados (por minuto)",
      "description": "¿Los clientes están pudiendo registrar sus problemas? Una caída a 0 con tráfico normal es un incidente de negocio.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(tickets_creados_total{namespace=\"$namespace\"}[5m])) * 60",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Tickets que fallaron al crearse (por minuto)",
      "description": "¿Cuántos clientes intentaron crear un ticket y recibieron un error del sistema?",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(tickets_creacion_fallida_total{namespace=\"$namespace\", motivo=\"error_interno\"}[5m])) * 60 or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Actividad del negocio",
      "description": "¿Cómo evoluciona lo que hacen los clientes y agentes? Tickets creados, tickets sin agente, notificaciones entregadas e inicios de sesión fallidos, por minuto.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(tickets_creados_total{namespace=\"$namespace\"}[5m])) * 60",
          "legendFormat": "tickets creados",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(tickets_sin_agente_total{namespace=\"$namespace\"}[5m])) * 60",
          "legendFormat": "tickets sin agente",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "sum(rate(notificaciones_procesadas_total{namespace=\"$namespace\", estado_envio=\"ENVIADA\"}[5m])) * 60",
          "legendFormat": "notificaciones enviadas",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        },
        {
          "expr": "sum(rate(logins_total{namespace=\"$namespace\", resultado=\"fallido\"}[5m])) * 60",
          "legendFormat": "logins fallidos",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tasa de consumo del presupuesto (burn rate)",
      "description": "¿A qué ritmo se gasta el presupuesto de error? 1 = se agota justo en 30 días. Por encima de 14.4 (1 h y 5 min) se dispara la alerta de página.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "slo:burnrate:1h{namespace=\"$namespace\"}",
          "legendFormat": "{{slo}} 1h",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "slo:burnrate:5m{namespace=\"$namespace\"}",
          "legendFormat": "{{slo}} 5m",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "slo:burnrate:6h{namespace=\"$namespace\"}",
          "legendFormat": "{{slo}} 6h",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Latencia — ¿qué tan rápido respondemos?",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Latencia que ve el usuario (gateway)",
      "description": "¿Cuánto espera un cliente? p50, p95 y p99 de todas las peticiones a /api/* medidas en el gateway.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sa_http_server_duration_seconds_bucket{service=\"gateway\", route=~\"/api/.*\", namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sa_http_server_duration_seconds_bucket{service=\"gateway\", route=~\"/api/.*\", namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sa_http_server_duration_seconds_bucket{service=\"gateway\", route=~\"/api/.*\", namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "p95 por servicio",
      "description": "¿Qué servicio es el lento? Si el gateway sube junto con un servicio de atrás, la causa está en ese servicio.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(sa_http_server_duration_seconds_bucket{namespace=\"$namespace\", service=~\"$servicio\"}[5m])))",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },

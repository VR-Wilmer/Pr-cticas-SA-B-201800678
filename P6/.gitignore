# Nunca se versiona (requisito B del enunciado): credenciales reales del
# cluster en la nube.
charts/sa-platform/secrets.local.yaml
**/secrets.local.yaml

# Dependencias/artefactos de build, se regeneran con pnpm install / tsc.
node_modules/
dist/
.pnpm-store/
__pycache__/
*.pyc

# Charts de terceros descargados por `helm dependency update` (no son
# nuestro codigo, se re-descargan siempre igual desde Chart.yaml).
charts/sa-platform/charts/postgresql
charts/sa-platform/charts/kafka
charts/sa-platform/charts/*.tgz
charts/sa-platform/Chart.lock

# Credenciales de gcloud/kubeconfig si alguna vez se exportan a un archivo
# dentro del repo por error (normalmente viven fuera del repo, en
# ~/.config/gcloud y ~/.kube).
*-key.json
kubeconfig-*

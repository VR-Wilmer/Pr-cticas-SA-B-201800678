# PostgreSQL (puerto de host distinto al 5432 usado por P1, para poder correr ambas practicas a la vez)
DB_HOST=postgres
DB_PORT=5433
DB_USER=p2_user
DB_PASSWORD=change_me
DB_NAME=p2_auth_db

# Backend
BACKEND_PORT=4000

# Frontend (el proxy de Vite reenvia /auth y /api al servicio "backend", ver vite.config.ts)
FRONTEND_PORT=5173

# JWT (tiempo de vida y periodo de gracia para renovacion automatica)
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_GRACE_PERIOD=5m

# AES-256-GCM (clave para cifrar nombre, correo y contrasena)
AES_SECRET_KEY=change_me_32_char_min_secret_key

# Microservicio de autorizacion (consultado por el backend con reintentos/backoff)
AUTHZ_SERVICE_PORT=4100
AUTHZ_SERVICE_URL=http://auth-service:4100
AUTHZ_MAX_RETRIES=3
AUTHZ_RETRY_BACKOFF_MS=300
